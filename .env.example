# Copie para .env e ajuste. Todas as variáveis são opcionais, exceto a credencial da Anthropic.

# --- Papel desta máquina ---
# all (padrão) = tudo em um PC só · hub = painel/agenda/publicação · worker = download/transcrição/IA/render.
# Guia do modo de um PC: docs/um-pc.md. No Windows, deploy\setup-windows.ps1 gera este arquivo.
ROLE=all
# Só para hub + worker em máquinas separadas: o mesmo segredo nos dois lados, e no worker o endereço do hub.
WORKER_TOKEN=
HUB_URL=

# --- Claude (curadoria) ---
ANTHROPIC_API_KEY=
# Modelo padrão quando o canal não define o seu. Opus 5.5 = melhor curadoria;
# claude-haiku-5-5 custa ~40x menos por vídeo se quiser priorizar custo.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# IA local (Ollama): auto = assume quando o Claude falha por crédito/limite · always = nunca usa o Claude · off.
LOCAL_AI=auto
LOCAL_MODEL=qwen3:8b

# --- Dashboard ---
# 0.0.0.0 = acessível pela rede (defina a senha) · 127.0.0.1 = só nesta máquina.
HOST=0.0.0.0
PORT=8080
DASHBOARD_USER=admin
# Defina SEMPRE em servidor exposto na rede (HTTP Basic Auth). Vazio = sem senha.
DASHBOARD_PASSWORD=
# URL pública do dashboard, usada no payload do webhook de publicação.
PUBLIC_URL=

# --- Dados ---
DATA_DIR=data

# --- Binários ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
WHISPER_BIN=whisper-cli
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
WHISPER_THREADS=8
WHISPER_LANGUAGE=pt
FACE_MODEL=face_detection_yunet_2023mar.onnx

# --- Render ---
# h264_nvenc / h264_vaapi se houver GPU; libx264 é o padrão universal.
FFMPEG_VCODEC=libx264
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
RENDER_FPS=30
RENDER_CONCURRENCY=1
SUBTITLE_FONT=Montserrat ExtraBold
SUBTITLE_FONTS_DIR=

# --- Posts de foto no Instagram (opcional; também configurável na aba Instagram do painel) ---
# Guia: docs/instagram.md
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
DEEPSEEK_API_KEY=
TEMPLATED_API_KEY=
TEMPLATE_ID_FEED=
TEMPLATE_ID_STORY=
# Porta que serve só as fotos públicas dos posts (para o túnel de deploy/ig-media-tunnel.sh). Vazio = desligada.
IG_MEDIA_PORT=
