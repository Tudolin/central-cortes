[Unit]
Description=Central de Cortes - túnel público das fotos do Instagram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/deploy/ig-media-tunnel.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
